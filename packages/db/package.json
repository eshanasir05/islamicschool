{
  "name": "@skooly/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env --test src/sensitive-paths.test.ts ../../apps/web/src/lib/authz.test.ts ../../apps/web/src/lib/tuition-reminder-policy.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline-existing": "tsx --env-file=.env src/baseline-existing-schema.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "db:reset-demo": "tsx --env-file=.env src/reset-demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
