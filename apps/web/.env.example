# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Project Settings → Database → Connection string
DATABASE_URL=                  # Transaction pooler (port 6543) — runtime
DATABASE_URL_DIRECT=           # Direct connection (port 5432) — migrations only

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORG_ID=            # UUID of your organization row

# Resend — resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=             # e.g. hello@talibly.com (must be a verified domain)
LEADS_TO_EMAIL=                # where demo requests are forwarded, e.g. you@talibly.com

# --- Not needed yet (leave blank) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NEXT_PUBLIC_POSTHOG_KEY=
# SENTRY_DSN=
# ANTHROPIC_API_KEY=
